<Window x:Class="AeroDriver.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:AeroDriver.UI.Helpers"
        Title="AeroDriver" Height="640" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}"
        TextElement.Foreground="{DynamicResource WindowForeground}">
    <Window.Resources>
        <!-- DataGrid の列ヘッダーはビジュアルツリー外のため DataContext を継承しない。
             Freezable は要素の Resources に置くと DataContext を継承するので、これを
             中継にして ViewModel のローカライズ済みラベルへ束縛する。
             App.xaml ではなくここに置くこと(アプリケーション辞書には DataContext が無い)。 -->
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </Window.Resources>

    <DockPanel Margin="8">

        <!-- ツールバー -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}" Padding="8,2" />
                <Button Content="{Binding CheckUpdatesButtonText}" Command="{Binding CheckUpdatesCommand}" Padding="8,2" />
                <Separator />
                <Button Content="{Binding InstallButtonText}" Command="{Binding InstallSelectedCommand}" Padding="8,2" />
                <Button Content="{Binding UpdateAllButtonText}" Command="{Binding InstallAllUpdatesCommand}" Padding="8,2" />
                <Button Content="{Binding CustomInstallButtonText}" Command="{Binding InstallCustomDriverCommand}" Padding="8,2" />
                <Separator />
                <Button Content="{Binding BackupButtonText}" Command="{Binding BackupSelectedCommand}" Padding="8,2" />
                <Button Content="{Binding RollbackButtonText}" Command="{Binding RollbackSelectedCommand}" Padding="8,2" />
                <Separator />
                <Button Content="{Binding Data.CancelButtonText, Source={StaticResource Proxy}}" Command="{Binding CancelCommand}" Padding="8,2" />
            </ToolBar>
            <ToolBar>
                <TextBlock Text="{Binding LanguageLabel}" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox ItemsSource="{Binding Cultures}"
                          SelectedItem="{Binding SelectedCulture}"
                          DisplayMemberPath="NativeName"
                          Width="150" Margin="4,0" />
                <Separator />
                <TextBlock Text="{Binding ThemeLabel}" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme}"
                          Width="90" Margin="4,0" />
            </ToolBar>
            <!-- 設定トグル。Core は以前からこれらを尊重していたが、変更手段が
                 設定ファイルの手編集しか無かった -->
            <ToolBar>
                <CheckBox Content="{Binding CreateRestorePointLabel}"
                          IsChecked="{Binding CreateRestorePointEnabled}"
                          VerticalAlignment="Center" Margin="4,0" />
                <Separator />
                <CheckBox Content="{Binding BackupBeforeInstallLabel}"
                          IsChecked="{Binding BackupBeforeInstall}"
                          VerticalAlignment="Center" Margin="4,0" />
                <Separator />
                <CheckBox Content="{Binding IncludeBetaLabel}"
                          IsChecked="{Binding IncludeBetaDrivers}"
                          VerticalAlignment="Center" Margin="4,0" />
                <Separator />
                <CheckBox Content="{Binding AutoCheckLabel}"
                          IsChecked="{Binding AutoCheckOnStartup}"
                          VerticalAlignment="Center" Margin="4,0" />
            </ToolBar>
        </ToolBarTray>

        <!-- ステータスバー -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <ProgressBar Width="120" Height="14" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <!-- メイン: 左=タブ(一覧)、右=詳細ペイン -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="1*" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0">
                <TabItem Header="{Binding InstalledTabHeader}">
                    <DataGrid ItemsSource="{Binding InstalledDrivers}"
                              SelectedItem="{Binding SelectedInstalledDriver}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowDetailsCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Data.ColumnDeviceNameText, Source={StaticResource Proxy}}" Binding="{Binding DeviceName}" Width="*" />
                            <DataGridTextColumn Header="{Binding Data.ColumnVersionText, Source={StaticResource Proxy}}" Binding="{Binding DriverVersion}" Width="120" />
                            <DataGridTextColumn Header="{Binding Data.ColumnProviderText, Source={StaticResource Proxy}}" Binding="{Binding DriverProviderName}" Width="160" />
                            <DataGridCheckBoxColumn Header="WHQL" Binding="{Binding IsWHQLCertified}" Width="60" />
                            <DataGridCheckBoxColumn Header="GPU" Binding="{Binding IsGraphicsDriver}" Width="50" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="{Binding UpdatesTabHeader}">
                    <DataGrid ItemsSource="{Binding AvailableUpdates}"
                              SelectedItem="{Binding SelectedUpdate}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding Data.ColumnDeviceNameText, Source={StaticResource Proxy}}" Binding="{Binding DeviceName}" Width="*" />
                            <DataGridTextColumn Header="{Binding Data.ColumnVersionText, Source={StaticResource Proxy}}" Binding="{Binding DriverVersion}" Width="120" />
                            <DataGridTextColumn Header="{Binding Data.ColumnProviderText, Source={StaticResource Proxy}}" Binding="{Binding DriverProviderName}" Width="160" />
                            <DataGridTextColumn Header="{Binding Data.ColumnSourceText, Source={StaticResource Proxy}}" Binding="{Binding UpdateSource}" Width="140" />
                            <DataGridCheckBoxColumn Header="WHQL" Binding="{Binding IsWHQLCertified}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <!-- 詳細ペイン: 選択ドライバーをダブルクリックすると GetDriverDetailsAsync を表示 -->
            <Border Grid.Column="2" BorderThickness="1" Margin="4,0,0,0"
                    BorderBrush="{DynamicResource BorderBrushColor}"
                    Background="{DynamicResource PanelBackground}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding Data.DetailTitleText, Source={StaticResource Proxy}}" FontWeight="Bold" Margin="0,0,0,6" />

                        <!-- 未選択時のプレースホルダー -->
                        <TextBlock Text="{Binding Data.DetailHintText, Source={StaticResource Proxy}}"
                                   Foreground="{DynamicResource SubtleForeground}" TextWrapping="Wrap"
                                   Visibility="{Binding SelectedDetail, Converter={StaticResource NullToVis}}" />

                        <!-- 詳細本体（SelectedDetail が非nullのときだけ表示） -->
                        <StackPanel Visibility="{Binding SelectedDetail, Converter={StaticResource NotNullToVis}}"
                                    DataContext="{Binding SelectedDetail}">
                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding Data.DetailManufacturerText, Source={StaticResource Proxy}}" /><Run Text=": " /><Run Text="{Binding Manufacturer}" /></TextBlock>
                            <TextBlock><Run Text="{Binding Data.ColumnVersionText, Source={StaticResource Proxy}}" /><Run Text=": " /><Run Text="{Binding DriverVersion}" /></TextBlock>
                            <TextBlock><Run Text="{Binding Data.DetailClassText, Source={StaticResource Proxy}}" /><Run Text=": " /><Run Text="{Binding DeviceClass}" /></TextBlock>
                            <TextBlock Text="{Binding ClassGuid, StringFormat='ClassGuid: {0}'}" TextWrapping="Wrap" />
                            <TextBlock><Run Text="{Binding Data.DetailStatusText, Source={StaticResource Proxy}}" /><Run Text=": " /><Run Text="{Binding Status}" /></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding Data.DetailPathText, Source={StaticResource Proxy}}" /><Run Text=": " /><Run Text="{Binding DriverPath}" /></TextBlock>
                            <TextBlock><Run Text="{Binding Data.DetailSizeText, Source={StaticResource Proxy}}" /><Run Text=": " /><Run Text="{Binding DriverSize, StringFormat='{0:N0} bytes'}" /></TextBlock>

                            <!-- 署名情報（CertificateInfo が非nullのときだけ） -->
                            <StackPanel Visibility="{Binding CertificateInfo, Converter={StaticResource NotNullToVis}}">
                                <Separator Margin="0,6" />
                                <TextBlock Text="{Binding Data.DetailSignatureText, Source={StaticResource Proxy}}" FontWeight="SemiBold" />
                                <StackPanel DataContext="{Binding CertificateInfo}">
                                    <TextBlock Text="{Binding Subject, StringFormat='Subject: {0}'}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Issuer, StringFormat='Issuer: {0}'}" TextWrapping="Wrap" />
                                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding Data.DetailValidToText, Source={StaticResource Proxy}}" /><Run Text=": " /><Run Text="{Binding ValidTo}" /></TextBlock>
                                    <TextBlock><Run Text="{Binding Data.DetailTrustedChainText, Source={StaticResource Proxy}}" /><Run Text=": " /><Run Text="{Binding IsTrustedChain}" /></TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
