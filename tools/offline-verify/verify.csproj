<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RestorePackages>false</RestorePackages>
  </PropertyGroup>
  <!-- Microsoft.Extensions.* は ASP.NET Core 共有フレームワークに同梱されているため、
       NuGet に到達できなくても FrameworkReference で参照できる -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../src/AeroDriver.Core/Helpers/HardwareIdParser.cs" />
    <Compile Include="../../src/AeroDriver.Core/Helpers/InstallerExitCode.cs" />
    <Compile Include="../../src/AeroDriver.Core/Helpers/VersionHelper.cs" />
    <Compile Include="../../src/AeroDriver.Core/Helpers/DriverInstallOrder.cs" />
    <Compile Include="../../src/AeroDriver.Core/Helpers/WqlSanitizer.cs" />
    <Compile Include="../../src/AeroDriver.Core/Models/DriverInstallResult.cs" />
    <Compile Include="../../src/AeroDriver.Core/Models/DriverInfo.cs" />
    <Compile Include="../../src/AeroDriver.Core/Models/InstallHistoryEntry.cs" />
    <!-- ILogger のみに依存するサービス/ヘルパー（WMI・COM 非依存のもの） -->
    <Compile Include="../../src/AeroDriver.Core/Interfaces/IInstallHistoryService.cs" />
    <Compile Include="../../src/AeroDriver.Core/Interfaces/ISettingsService.cs" />
    <Compile Include="../../src/AeroDriver.Core/Services/InstallHistoryService.cs" />
    <Compile Include="../../src/AeroDriver.Core/Services/SettingsService.cs" />
    <Compile Include="../../src/AeroDriver.Core/Services/VulnerableDriverBlocklist.cs" />
    <Compile Include="../../src/AeroDriver.Core/Helpers/AuthenticodeHelper.cs" />
    <Compile Include="../../src/AeroDriver.Core/Helpers/SystemRestoreHelper.cs" />
    <Compile Include="../../src/AeroDriver.Core/Helpers/ElevationGuard.cs" />
    <!-- WMI 非依存のサービス（HTTP/プロセス/COM遅延バインディング） -->
    <Compile Include="../../src/AeroDriver.Core/Interfaces/IDriverUpdateSource.cs" />
    <Compile Include="../../src/AeroDriver.Core/Interfaces/IWhqlDatabaseService.cs" />
    <Compile Include="../../src/AeroDriver.Core/Interfaces/IBackupService.cs" />
    <Compile Include="../../src/AeroDriver.Core/Services/PciIdDatabase.cs" />
    <Compile Include="../../src/AeroDriver.Core/Services/WhqlDatabaseService.cs" />
    <Compile Include="../../src/AeroDriver.Core/Services/PnpUtilDriverSource.cs" />
    <Compile Include="../../src/AeroDriver.Core/Services/WindowsUpdateAgentSource.cs" />
    <Compile Include="../../src/AeroDriver.Core/Services/BackupService.cs" />
  </ItemGroup>
</Project>
