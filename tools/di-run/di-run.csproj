<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Core は net8.0 のまま [SupportedOSPlatform("windows")] 付きヘルパーを呼ぶため
         CA1416 が多数出る。実行時は OperatingSystem.IsWindows() でガードされている既知の誤検出 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <ItemGroup>
    <!-- WMI と AddStandardResilienceHandler の最小スタブは core-typecheck と共有する -->
    <Compile Include="../core-typecheck/Stubs.cs" />
    <Compile Include="../../src/AeroDriver.Core/**/*.cs" Exclude="../../src/AeroDriver.Core/obj/**/*.cs;../../src/AeroDriver.Core/bin/**/*.cs" />
  </ItemGroup>
</Project>
